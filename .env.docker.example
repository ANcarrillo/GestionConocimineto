# Configuración de Docker. Copie este archivo como .env (en la carpeta raíz del proyecto)
# y cambie las claves. El archivo .env no se sube a GitHub.

# Base de datos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambie-esta-clave

# Clave para firmar las sesiones y el CAPTCHA. Genere una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambie-esta-clave-secreta

# Datos con que se crea la base la primera vez (archivo dentro de database/)
DATOS_INICIALES=datos_prueba.sql

# Puertos en el PC
PUERTO_WEB=8080
PUERTO_API=8001
PUERTO_DB=5433

# Dirección desde la que se abre la web (si cambia PUERTO_WEB, cámbielo aquí también)
CORS_ORIGINS=http://localhost:8080

CAPTCHA_HABILITADO=true
