{
  // Terminal > Ejecutar tarea... (Ctrl+Shift+P > "Tasks: Run Task")
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend (FastAPI)",
      "type": "shell",
      "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe",
      "args": ["-m", "uvicorn", "app.main:app", "--reload", "--port", "8000"],
      "options": { "cwd": "${workspaceFolder}\\backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "servidores" }
    },
    {
      "label": "Frontend (React)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}\\frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "servidores" }
    },
    {
      "label": "Iniciar back y front",
      "dependsOn": ["Backend (FastAPI)", "Frontend (React)"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Pruebas backend (pytest)",
      "type": "shell",
      "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe",
      "args": ["-m", "pytest", "-q"],
      "options": { "cwd": "${workspaceFolder}\\backend" },
      "problemMatcher": []
    },
    {
      "label": "Entrenar modelo ML",
      "type": "shell",
      "command": "${workspaceFolder}\\ml\\.venv\\Scripts\\python.exe",
      "args": ["-m", "src.entrenar"],
      "options": { "cwd": "${workspaceFolder}\\ml" },
      "problemMatcher": []
    }
  ]
}
